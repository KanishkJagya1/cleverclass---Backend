# ================= Core =================
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ================= Database =================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cleverclass?schema=public"

# ================= Auth =================
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ================= Google Sign-In (optional) =================
# Leave empty to disable. Set GOOGLE_CLIENT_ID to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ================= Payments (Razorpay) =================
# Leave keys empty during development. Set PAYMENT_BYPASS=true to skip the
# real gateway and auto-mark orders as paid (dev/testing). Set to false in prod
# once real keys are provided.
PAYMENT_BYPASS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ================= Storage =================
# Resolution order: if S3_* is fully set -> S3; else if GCP_* is set -> GCP;
# else -> LOCAL disk (uploads/ folder).
STORAGE_LOCAL_DIR=uploads

# --- S3 (optional) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- GCP (optional) ---
GCP_BUCKET=
GCP_PROJECT_ID=
# Path to service account json OR base64 of it
GOOGLE_APPLICATION_CREDENTIALS=

# ================= Seed accounts =================
ADMIN_EMAIL=admin@cleverclass.com
ADMIN_PASSWORD=Admin@123
MANAGER_EMAIL=manager@cleverclass.com
MANAGER_PASSWORD=Manager@123
